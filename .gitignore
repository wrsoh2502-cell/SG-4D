# Android build output — regenerated by gradlew, never committed.
android/build/
android/app/build/
android/.gradle/
# Machine-specific SDK path.
android/local.properties

# Signing material. The real keystore lives one level up, outside this repo,
# and must stay there — these patterns are a tripwire, not the primary defence.
*.jks
*.keystore
keystore.properties

# Build logs and scratch.
tools/*.log
*.apk

# OS cruft.
Thumbs.db
.DS_Store
desktop.ini

# Deliberately NOT published. These came from the store-submission work, not the
# app itself, and a public repo is the wrong home for them:
#   PLAY_STORE_LISTING.md — internal ASO strategy plus a candid Play-policy risk
#     assessment of our own app. Useful to us, not something to publish where
#     Google and competitors read it.
#   store-assets/ — marketing creative, published through Play Console instead.
# Delete these two lines if you decide otherwise; adding them later is easy,
# un-publishing them is not.
PLAY_STORE_LISTING.md
store-assets/
